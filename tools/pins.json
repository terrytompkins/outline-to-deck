{
  "_comment": "Library pins for every deck. Single source for assemble-deck.py, check-deck.py and the docs. Fill or refresh the sri fields with: python3 tools/update-pins.py",
  "libraries": {
    "reveal": {
      "version": "6.0.2",
      "files": {
        "reset_css": {
          "kind": "css",
          "cdnjs": {"url": "https://cdnjs.cloudflare.com/ajax/libs/reveal.js/6.0.2/reset.css", "sri": null},
          "jsdelivr": {"url": "https://cdn.jsdelivr.net/npm/reveal.js@6.0.2/dist/reset.css", "sri": null},
          "local": "node_modules/reveal.js/dist/reset.css"
        },
        "core_css": {
          "kind": "css",
          "cdnjs": {"url": "https://cdnjs.cloudflare.com/ajax/libs/reveal.js/6.0.2/reveal.css", "sri": null},
          "jsdelivr": {"url": "https://cdn.jsdelivr.net/npm/reveal.js@6.0.2/dist/reveal.css", "sri": null},
          "local": "node_modules/reveal.js/dist/reveal.css"
        },
        "core_js": {
          "kind": "js",
          "global": "Reveal",
          "cdnjs": {"url": "https://cdnjs.cloudflare.com/ajax/libs/reveal.js/6.0.2/reveal.min.js", "sri": null},
          "jsdelivr": {"url": "https://cdn.jsdelivr.net/npm/reveal.js@6.0.2/dist/reveal.js", "sri": null},
          "local": "node_modules/reveal.js/dist/reveal.js"
        },
        "notes_js": {
          "kind": "js",
          "global": "RevealNotes",
          "cdnjs": {"url": "https://cdnjs.cloudflare.com/ajax/libs/reveal.js/6.0.2/plugin/notes.min.js", "sri": null},
          "jsdelivr": {"url": "https://cdn.jsdelivr.net/npm/reveal.js@6.0.2/dist/plugin/notes.js", "sri": null},
          "local": "node_modules/reveal.js/dist/plugin/notes.js"
        }
      }
    },
    "mermaid": {
      "version": "12.3.0",
      "load": "only when the deck contains a diagram",
      "files": {
        "core_js": {
          "kind": "js",
          "global": "mermaid",
          "cdnjs": {"url": "https://cdnjs.cloudflare.com/ajax/libs/mermaid/12.3.0/mermaid.min.js", "sri": null},
          "jsdelivr": {"url": "https://cdn.jsdelivr.net/npm/mermaid@12.3.0/dist/mermaid.min.js", "sri": null},
          "local": "node_modules/mermaid/dist/mermaid.min.js"
        }
      }
    }
  }
}
